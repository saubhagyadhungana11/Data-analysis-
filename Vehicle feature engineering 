      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "df = pd.read_csv('used_cars.csv')\n",
        "\n",
        "# Clean 'milage' column: remove ' mi.' suffix and commas, then convert to numeric\n",
        "df['milage'] = df['milage'].astype(str).str.replace(' mi.', '', regex=False).str.replace(',', '').apply(pd.to_numeric, errors='coerce')\n",
        "\n",
        "# Clean 'price' column: remove '$' and commas, then convert to numeric\n",
        "df['price'] = df['price'].astype(str).str.replace('$', '', regex=False).str.replace(',', '').apply(pd.to_numeric, errors='coerce')\n",
        "\n",
        "# Display the first 5 rows of the DataFrame to verify the cleaning\n",
        "display(df.head())"
      ]
