        "import pandas as pd\n",
        "\n",
        "df = pd.read_csv('WA_Fn-UseC_-Telco-Customer-Churn.csv')\n",
        "\n",
        "df[\"TotalCharges\"] = pd.to_numeric(df[\"TotalCharges\"], errors=\"coerce\")\n",
        "df[\"TotalCharges\"] = df[\"TotalCharges\"].fillna(0)\n",
        "df[\"Churn_Flag\"] = (df[\"Churn\"] == \"Yes\").astype(int)\n",
        "\n",
        "def tenure_group(tenure):\n",
        "    if tenure <= 12:\n",
        "        return \"New\"\n",
        "    elif tenure <= 48:\n",
        "        return \"Established\"\n",
        "    else:\n",
        "        return \"Loyal\"\n",
        "\n",
        "df[\"Tenure_Group\"] = df[\"tenure\"].apply(tenure_group)\n",
        "\n",
        "service_cols = [\"OnlineSecurity\", \"OnlineBackup\", \"DeviceProtection\",\n",
        "                \"TechSupport\", \"StreamingTV\", \"StreamingMovies\"]\n",
        "\n",
        "df[\"Total_Services\"] = df[service_cols].apply(\n",
        "    lambda row: (row == \"Yes\").sum(), axis=1\n",
        ")\n",
        "\n",
        "churn_by_tenure = df.groupby(\"Tenure_Group\")[\"Churn_Flag\"].mean().mul(100).round(1)\n",
        "churn_by_services = df.groupby(\"Total_Services\")[\"Churn_Flag\"].mean().mul(100).round(1)\n",
        "\n",
        "print(\"Churn Rate by Tenure Group:\")\n",
        "print(churn_by_tenure)\n",
        "print(\"\\nChurn Rate by Number of Services:\")\n",
        "print(churn_by_services)\n",
        "\n",
        "mysterious = df.groupby([\"Tenure_Group\", \"Total_Services\"])[\"Churn_Flag\"].mean().mul(100).round(1)\n",
        "print(\"\\nChurn Rate by Tenure Group × Services:\")\n",
        "print(mysterious)"
      ]
    },
