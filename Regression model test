      "source": [
        "import re\n",
        "\n",
        "# 1. Feature Engineering: car_age\n",
        "current_year = pd.Timestamp.now().year\n",
        "year_col = [col for col in df.columns if 'year' in col.lower()][0]\n",
        "df['car_age'] = current_year - df[year_col]\n",
        "\n",
        "# 2. Feature Engineering: mileage_per_year\n",
        "# Correcting spelling search to match 'milage' or similar, and cleaning numeric values\n",
        "mileage_col = [col for col in df.columns if 'mil' in col.lower() or 'odo' in col.lower()][0]\n",
        "\n",
        "def clean_mileage(val):\n",
        "    if pd.isna(val):\n",
        "        return np.nan\n",
        "    cleaned = re.sub(r'[^0-9]', '', str(val))\n",
        "    return float(cleaned) if cleaned else np.nan\n",
        "\n",
        "df['cleaned_mileage'] = df[mileage_col].apply(clean_mileage)\n",
        "df['mileage_per_year'] = df['cleaned_mileage'] / (df['car_age'] + 1)\n",
        "\n",
        "# 3. Encode brand_tier as 0/1\n",
        "# If 'brand_tier' is not present, we will define high-tier (luxury) brands based on the 'brand' column\n",
        "if 'brand_tier' not in df.columns:\n",
        "    luxury_brands = ['Lexus', 'INFINITI', 'BMW', 'Mercedes-Benz', 'Audi', 'Porsche', 'Cadillac', 'Land', 'Tesla', 'Jaguar']\n",
        "    df['brand_tier_encoded'] = df['brand'].apply(lambda x: 1 if str(x).strip() in luxury_brands else 0)\n",
        "else:\n",
        "    df['brand_tier_encoded'] = df['brand_tier'].astype('category').cat.codes\n",
        "\n",
        "# Find and clean Price column\n",
        "price_col = [col for col in df.columns if 'price' in col.lower()][0]\n",
        "def clean_price(val):\n",
        "    if pd.isna(val):\n",
        "        return np.nan\n",
        "    cleaned = re.sub(r'[^0-9.]', '', str(val))\n",
        "    return float(cleaned) if cleaned else np.nan\n",
        "\n",
        "df['cleaned_price'] = df[price_col].apply(clean_price)\n",
        "\n",
        "# Select Target and Features\n",
        "features = ['car_age', 'mileage_per_year', 'brand_tier_encoded']\n",
        "X = df[features]\n",
        "y = df['cleaned_price']\n",
        "\n",
        "# Drop NaNs\n",
        "valid_idx = X.notna().all(axis=1) & y.notna()\n",
        "X = X[valid_idx]\n",
        "y = y[valid_idx]\n",
        "\n",
        "display(X.head())"
      ],
