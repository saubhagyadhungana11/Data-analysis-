      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Create a bar chart for layoffs by industry\n",
        "plt.figure(figsize=(12, 7))\n",
        "sns.barplot(x=by_industry.index, y=by_industry.values, palette='viridis')\n",
        "plt.title('Total Layoffs by Industry')\n",
        "plt.xlabel('Industry')\n",
        "plt.ylabel('Total Employees Laid Off')\n",
        "plt.xticks(rotation=90)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
